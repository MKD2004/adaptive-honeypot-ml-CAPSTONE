# Settings for honeypot-guard.service (the root script that edits the firewall).
# Copy to /etc/honeypot-guard/guard.env.
#
# The address(es) YOU log in from. The script will never block these, whatever the block
# list says. Comma separated; CIDR networks are allowed. Use the same value as
# MITIGATION_NEVER_BLOCK in /etc/honeypot/pipeline.env.
#HONEYPOT_GUARD_NEVER_BLOCK=198.51.100.7
