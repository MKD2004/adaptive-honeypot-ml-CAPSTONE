# Copy to .env.local (gitignored) to change where the dashboard finds the API.

# Where Vite's dev/preview proxy forwards /api/* (traffic_gateway/api.py).
# Default: http://localhost:5000
VITE_API_PROXY_TARGET=http://localhost:5000

# Optional: call the API directly instead of through the proxy (it is
# CORS-enabled). Leave unset to use the proxy, which also works when the
# dashboard is opened from another laptop on the LAN.
# VITE_API_BASE_URL=http://192.168.0.110:5000
