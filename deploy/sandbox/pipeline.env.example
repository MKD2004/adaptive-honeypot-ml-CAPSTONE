# Settings for honeypot-pipeline.service.
# Copy to /etc/honeypot/pipeline.env  (root-owned, mode 640, group honeypot).
# One KEY=value per line. No quotes, no spaces around "=".

# ---- Where the pipeline keeps its own state (the runbook creates these folders) ------------
GATEWAY_DATA_DIR=/var/lib/honeypot/gateway/data
GATEWAY_LOG_DIR=/var/lib/honeypot/gateway/logs

# ---- DistilBERT (the text features). It is downloaded once, then kept here. ----------------
HF_HOME=/var/lib/honeypot/hf
# 0 = may download. After the first successful start (the log says "semantic encoder ready")
# set it to 1 and restart, so the server never contacts the model hub again.
HF_HUB_OFFLINE=0

# ---- Provenance. SET THIS. ------------------------------------------------------------------
# Written on every line of the results file, so real internet captures can never be pooled
# with demo or injected sessions in one statistic. Left unset it records "unspecified", which
# is exactly what you do not want on the one box that produces the real data the paper rests
# on. 1-40 letters, digits, dots, dashes or underscores; a bad value stops start-up.
PIPELINE_SOURCE=internet

# ---- Mitigation. STAGE 0 = watch only. Do not change these in the first week. ---------------
# observe : decisions are written to the audit log; nothing is blocked.
# enforce : needs MITIGATION_FIREWALL=1 as well before anything is really blocked.
MITIGATION_MODE=observe
MITIGATION_FIREWALL=0
# These three paths must match honeypot-guard.service and the folders in the runbook.
MITIGATION_BLOCKLIST_PATH=/var/lib/honeypot-guard/blocklist.json
MITIGATION_KILL_FILE=/var/lib/honeypot-guard/MITIGATION_DISABLED
MITIGATION_AUDIT_PATH=/var/lib/honeypot/mitigation/mitigation_audit.jsonl
# The address(es) YOU log in from, so they can never be blocked. Comma separated, CIDR allowed.
# Also put the same value in /etc/honeypot-guard/guard.env. verify_sandbox.sh warns if it is empty.
#MITIGATION_NEVER_BLOCK=198.51.100.7

# ---- The dashboard API is NOT part of this kit ----------------------------------------------
# honeypot-pipeline.service runs `python -m traffic_gateway.post_session_pipeline`, which has
# no HTTP server at all -- on a collection box there is nothing to serve and nothing to
# protect. Nothing below is needed unless you deliberately swap in
# `python -m traffic_gateway.run_pipeline`, which does start the API. If you do:
#   - it binds 127.0.0.1 by default, which is what you want here;
#   - binding anything reachable without GATEWAY_API_TOKEN set is REFUSED at start-up,
#     because POST /api/whitelist would otherwise let anyone whitelist themselves past the
#     gateway, the honeypot and MT3 (HONEYPOT_AUDIT.md PART 3);
#   - generate a token with: python -m traffic_gateway.api_auth
#GATEWAY_API_TOKEN=
#GATEWAY_API_ORIGINS=https://your-console.example.com
#GATEWAY_API_REQUIRE_AUTH_FOR_READS=1

# ---- MT3 trust ------------------------------------------------------------------------------
# MT3's verdict may only drive the blacklist and the honeypot reconfiguration for sources it
# was trained on. Cowrie sessions carry source="cowrie_real", so the default is correct here
# and needs no setting. Do NOT add other sources without first passing
# `python -m ml_analytics.mt3_pipeline.acceptance_heralding` against the model you are running
# (HONEYPOT_AUDIT.md PARTS 7-8).
