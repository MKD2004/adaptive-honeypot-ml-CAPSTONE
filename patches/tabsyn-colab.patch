+# Minimal local shim for the "zero" ML-training-utility API that TabSyn's
+# vendored src/ package expects (src/deep.py, src/util.py). NOT the PyPI
+# "zero" package (a linear circuit simulator that squats this name) --
+# pip has no installable version of the original Yandex Research "zero"
+# library, so this replaces it. Only implements what's actually referenced:
+# zero.random.get_state/set_state, zero.iter_batches, zero.hardware.get_gpus_info.
+# Shadows the PyPI package because Python puts the running script's own
+# directory (tabsyn/) ahead of site-packages on sys.path.
+import random as _random
+
+import numpy as _np
+import torch as _torch
+
+
+class random:
+    @staticmethod
+    def get_state():
+        return (_random.getstate(), _np.random.get_state(), _torch.get_rng_state())
+
+    @staticmethod
+    def set_state(state):
+        py_state, np_state, torch_state = state
+        _random.setstate(py_state)
+        _np.random.set_state(np_state)
+        _torch.set_rng_state(torch_state)
+
+
+def iter_batches(batch, chunk_size):
+    n = len(batch)
+    for i in range(0, n, chunk_size):
+        if isinstance(batch, (tuple, list)):
+            yield type(batch)(x[i:i + chunk_size] for x in batch)
+        else:
+            yield batch[i:i + chunk_size]
+
+
+class hardware:
+    @staticmethod
+    def get_gpus_info():
+        if not _torch.cuda.is_available():
+            return []
+        return [{
+            "name": _torch.cuda.get_device_name(i),
+            "memory_total": _torch.cuda.get_device_properties(i).total_memory,
+        } for i in range(_torch.cuda.device_count())]
