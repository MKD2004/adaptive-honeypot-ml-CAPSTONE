# Settings for docker-compose.yml. Copy to deploy/sandbox/cowrie.env and start with:
#   docker compose --env-file ./cowrie.env up -d

# Which host address and port attackers connect to.
# Start on 2222: it needs no change to your own SSH, so you cannot lock yourself out.
# Move to 22 only after the checks pass and your own SSH has been moved (README, part B).
COWRIE_BIND_IP=0.0.0.0
COWRIE_PUBLIC_PORT=2222

# Leave unset at first (uses cowrie/cowrie:latest). After the first run, verify_sandbox.sh
# prints the image digest. Paste it here as  cowrie/cowrie@sha256:...  to pin the version.
#COWRIE_IMAGE=cowrie/cowrie@sha256:
