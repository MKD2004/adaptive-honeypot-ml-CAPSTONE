# Base URL of the traffic_gateway/api.py Flask API.
# Copy this file to .env.local (gitignored) and change it if the gateway runs
# somewhere other than this machine. If unset, src/services/api.js falls back
# to http://127.0.0.1:5000 on its own.
#
# Use the IPv4 literal, NOT localhost. On Windows `localhost` resolves to ::1
# (IPv6) first, while Flask's --host 0.0.0.0 binds IPv4 only -- so
# http://localhost:5000 is refused and every page reports "Gateway API
# unreachable" while the API is actually running fine.
VITE_API_BASE_URL=http://127.0.0.1:5000
