# Settings for honeypot-pipeline.service.
# Copy to /etc/honeypot/pipeline.env  (root-owned, mode 640, group honeypot).
# One KEY=value per line. No quotes, no spaces around "=".

# ---- Where the pipeline keeps its own state (the runbook creates these folders) ------------
GATEWAY_DATA_DIR=/var/lib/honeypot/gateway/data
GATEWAY_LOG_DIR=/var/lib/honeypot/gateway/logs

# ---- DistilBERT (the text features). It is downloaded once, then kept here. ----------------
HF_HOME=/var/lib/honeypot/hf
# 0 = may download. After the first successful start (the log says "semantic encoder ready")
# set it to 1 and restart, so the server never contacts the model hub again.
HF_HUB_OFFLINE=0

# ---- Mitigation. STAGE 0 = watch only. Do not change these in the first week. ---------------
# observe : decisions are written to the audit log; nothing is blocked.
# enforce : needs MITIGATION_FIREWALL=1 as well before anything is really blocked.
MITIGATION_MODE=observe
MITIGATION_FIREWALL=0
# These three paths must match honeypot-guard.service and the folders in the runbook.
MITIGATION_BLOCKLIST_PATH=/var/lib/honeypot-guard/blocklist.json
MITIGATION_KILL_FILE=/var/lib/honeypot-guard/MITIGATION_DISABLED
MITIGATION_AUDIT_PATH=/var/lib/honeypot/mitigation/mitigation_audit.jsonl
# The address(es) YOU log in from, so they can never be blocked. Comma separated, CIDR allowed.
# Also put the same value in /etc/honeypot-guard/guard.env. verify_sandbox.sh warns if it is empty.
#MITIGATION_NEVER_BLOCK=198.51.100.7
