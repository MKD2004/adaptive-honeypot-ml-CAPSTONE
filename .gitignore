__pycache__/
*.pyc
.env
venv/
.idea/
.vscode/
logs/
honeypot_dataset/data/

# Pipeline runtime state (regenerated on every run)
adaptive_honeypot/active_config.json
demo/*_host_key
honeypot_dataset/cowrie/logs/
honeypot_dataset/cowrie/honeyfs/
traffic_gateway/logs/
traffic_gateway/data/blacklist.json
traffic_gateway/data/whitelist.json
cve_intelligence/data/live/
honeypot_dataset/venv/
*.npy
*.npz
# EXCEPT the generator's gap calibration: real inter-arrival gaps resampled
# by cowrie_simulator. 450 KB, and without it the generator cannot run on a
# machine that lacks the (gitignored) capture.
!honeypot_dataset/src/generators/cowrie_gaps.npz
# Real command sequences the generator resamples. Attacker-written text,
# deduplicated and weighted; DATA only, never executed.
!honeypot_dataset/src/generators/cowrie_commands.json.gz
*.pkl
*.parquet
tabsyn/
*.zip

# Per-machine notes: each laptop/server keeps its own, never shared
# (DGX.md stays committed - every machine needs it)
ASUS.md
HARDWARE.md
SETUP.md

# Local-only working notes: session findings + outgoing teammate briefs
# (never shared - these are per-session working docs, not project state)
FINDINGS_*.md
TEAMMATE_*.md

# per-machine working notes (like ASUS.md / HARDWARE.md / SETUP.md)
SESSION_CONTEXT.md

# Local screen-recording script (personal, not shared)
DEMORUN.md

# Not part of this project. Left on disk on purpose rather than deleted -- these
# are personal/other-project files and deleting them is not reversible.
Resume_*.pdf
pulse-engineering-metrics-and-incident-response-console/
pulse-engineering-metrics-and-incident-response-console.zip

# Real honeypot captures: 180 MB+ of raw logs. Irreplaceable, but raw data
# does not belong in git -- back it up outside the repo.
cowrie_logs_*/
# The 13-day capture lands in `cowrie_logs/` with no suffix, which the
# pattern above does NOT match -- it was written for cowrie_logs_20261109/.
# 440 MB of attacker-written logs was committable until 2026-11-15.
cowrie_logs/

# Gateway runtime state, not source. These are written by gateway_logger and
# session_tracker as the gateway runs, and demo/reset_demo.py deletes them, so
# they are disposable by design. Committing them meant every demo run showed up
# as a source change, and one machine's blacklist state leaked into another's
# checkout. The directory is recreated by GatewayConfig.__post_init__.
traffic_gateway/data/ip_records.json
traffic_gateway/data/sessions.jsonl
